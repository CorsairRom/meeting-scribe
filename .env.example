# Copy to $XDG_CONFIG_HOME/meeting-scribe/.env (default: ~/.config/meeting-scribe/.env).
# Fallback for development: ./.env in the working directory. Process environment wins over both.
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
LOG_LEVEL=INFO
# "~" is expanded to your home directory.
STORAGE_MEETINGS_DIR=~/Documents/meetings
# Seconds per audio chunk (>= 1).
RECORDING_CHUNK_SECONDS=30
# Seconds to wait for ffmpeg to finish after stop before terminating it (> 0).
RECORDING_STOP_TIMEOUT_SECONDS=10
# ffmpeg executable name or path.
RECORDING_FFMPEG_BINARY=ffmpeg
# Sample rate of the recorded chunks in Hz.
RECORDING_SAMPLE_RATE=16000
# "cuda" (default) or "cpu". No automatic fallback: with "cuda" and no usable GPU a job fails.
PROCESSING_DEVICE=cuda
# Worker stage timeout is max(MIN_TIMEOUT_SECONDS, audio length x FACTOR) (> 0).
PROCESSING_WORKER_TIMEOUT_FACTOR=1.0
PROCESSING_WORKER_MIN_TIMEOUT_SECONDS=900
# Seconds between SIGTERM and SIGKILL when stopping a worker (> 0).
PROCESSING_WORKER_KILL_GRACE_SECONDS=5
# Send a desktop notification when a job ends (F3.4a).
PROCESSING_NOTIFY=true
# JSON list: seconds to wait before each retry when meeting.json cannot be saved or read (each > 0, at least one).
PROCESSING_STORAGE_RETRY_DELAYS_SECONDS=[2, 8, 30]
# faster-whisper model name or path (not empty).
TRANSCRIPTION_MODEL=large-v3-turbo
# ISO language code, or "auto" to detect it from the first 30 seconds.
TRANSCRIPTION_LANGUAGE=es
# CTranslate2 compute type on CUDA.
TRANSCRIPTION_COMPUTE_TYPE=float16
# Compute type when PROCESSING_DEVICE=cpu.
TRANSCRIPTION_CPU_COMPUTE_TYPE=int8
# Beam size (>= 1).
TRANSCRIPTION_BEAM_SIZE=5
# Silero VAD pre-filter.
TRANSCRIPTION_VAD_FILTER=true
# Feed the previous text back as a prompt (off avoids repetition loops on long audio).
TRANSCRIPTION_CONDITION_ON_PREVIOUS_TEXT=false
# pyannote pipeline id (not empty); needs a Hugging Face login, see the F3 runbook once it exists.
SPEAKERS_PIPELINE=pyannote/speaker-diarization-community-1
# Remote speaker count. Leave unset for automatic detection (>= 1 when set).
# SPEAKERS_NUM_SPEAKERS=
# Bounds when the count is automatic (>= 1; min must not exceed max).
# SPEAKERS_MIN_SPEAKERS=
# SPEAKERS_MAX_SPEAKERS=
# Same-speaker silence in seconds that still joins one utterance (>= 0).
SPEAKERS_UTTERANCE_GAP_SECONDS=5.0
# dB of residual mic energy over predicted loudspeaker bleed plus noise needed to label "Me" (>= 0).
SPEAKERS_ME_DOMINANCE_DB=6.0
# dB of residual mic energy over the mic noise floor needed to count as speech (>= 0).
SPEAKERS_ME_NOISE_MARGIN_DB=10.0
# Shortest "Me" turn kept, in seconds (> 0).
SPEAKERS_ME_MIN_TURN_SECONDS=0.5
# Clips per speaker voice sample (>= 1).
SPEAKERS_SAMPLE_MAX_CLIPS=3
# Target total length of a voice sample in seconds (> 0).
SPEAKERS_SAMPLE_TARGET_SECONDS=15.0
# Clip length bounds in seconds (> 0; min must not exceed max).
SPEAKERS_SAMPLE_MIN_CLIP_SECONDS=1.5
SPEAKERS_SAMPLE_MAX_CLIP_SECONDS=6.0
